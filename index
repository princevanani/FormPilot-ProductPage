<script>
function goPage(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  var el = document.getElementById('page-'+name);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-links a').forEach(a=>a.classList.remove('active'));
  var nv = document.querySelector('.nav-links a[data-nav="'+name+'"]');
  if(nv) nv.classList.add('active');
  window.scrollTo(0,0);
  if(history.pushState) history.pushState(null,'','#'+name);
  else location.hash = name;
}
function goHash(id){
  if(['home','privacy','terms','faq','contact'].indexOf(id)===-1 && document.getElementById('page-home')){
    goPage('home');
  }
  setTimeout(function(){
    var el = document.getElementById(id);
    if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
  }, 60);
}
function toggleMobileNav(open){
  var nav = document.getElementById('mobileNav');
  if(open){ nav.classList.add('open'); document.body.style.overflow='hidden'; }
  else { nav.classList.remove('open'); document.body.style.overflow=''; }
}
function toggleFaq(el){
  var item = el.parentElement;
  var wasOpen = item.classList.contains('open');
  item.classList.toggle('open', !wasOpen);
}
/* ============================================================
   SITE CONFIG — edit these three values, nothing else needed.
   ============================================================ */
var SITE_CONFIG = {
  storeUrl:     '',                  // e.g. 'https://chromewebstore.google.com/detail/formpilot/abcdef...'
  supportEmail: '',                  // e.g. 'support@yourdomain.com'
  lastUpdated:  'October 2026',      // shown on the Privacy Policy and Terms pages
  launchBanner: 'FormPilot launches October 11, 2026 on the Chrome Web Store'   // set to '' to hide the top banner
};
function toast(msg){
  var t = document.getElementById('toast');
  if(!t){ t = document.createElement('div'); t.id='toast'; t.className='toast'; document.body.appendChild(t); }
  t.textContent = msg; t.classList.add('show');
  clearTimeout(window.__toastT); window.__toastT = setTimeout(function(){ t.classList.remove('show'); }, 3800);
}
function applyConfig(){
  document.querySelectorAll('.js-date').forEach(function(el){ if(SITE_CONFIG.lastUpdated) el.textContent = SITE_CONFIG.lastUpdated; });
  document.querySelectorAll('.js-email').forEach(function(el){ if(SITE_CONFIG.supportEmail) el.textContent = SITE_CONFIG.supportEmail; });
  document.querySelectorAll('.js-store').forEach(function(el){
    el.addEventListener('click', function(e){
      e.preventDefault();
      if(SITE_CONFIG.storeUrl){ window.open(SITE_CONFIG.storeUrl, '_blank', 'noopener'); }
      else { toast('The Chrome Web Store link will appear here on launch day — October 11, 2026.'); }
    });
  });
  document.querySelectorAll('.js-mailto').forEach(function(el){
    el.addEventListener('click', function(e){
      e.preventDefault();
      if(SITE_CONFIG.supportEmail){
        var sub = el.getAttribute('data-subject');
        window.location.href = 'mailto:' + SITE_CONFIG.supportEmail + (sub ? '?subject=' + encodeURIComponent(sub) : '');
      } else { toast('Support email coming soon.'); }
    });
  });
  if(SITE_CONFIG.launchBanner){
    var b = document.getElementById('announce'); var bt = document.getElementById('announceText');
    if(b && bt){ bt.textContent = SITE_CONFIG.launchBanner; b.style.display = 'flex'; }
  }
}
function scrollToId(id){ var el = document.getElementById(id); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }
(function(){
  applyConfig();
  var known = ['home','privacy','terms','faq','contact'];
  var h = (location.hash||'').replace('#','');
  if(known.indexOf(h)!==-1){ goPage(h); } else { goPage('home'); }
  window.addEventListener('hashchange', function(){
    var hh = (location.hash||'').replace('#','');
    if(known.indexOf(hh)!==-1) goPage(hh);
  });
})();
</script>

